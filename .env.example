# ── Splunk ───────────────────────────────────────────────────────────────────
SPLUNK_HOST=localhost
SPLUNK_PORT=8089
SPLUNK_HEC_PORT=8088
SPLUNK_USERNAME=admin
SPLUNK_PASSWORD=YourSplunkPassword
SPLUNK_TOKEN=your-splunk-api-token
SPLUNK_HEC_TOKEN=your-hec-token
SPLUNK_INDEX=neuroscale
SPLUNK_VERIFY_SSL=false

# ── LLM (Agent Brain — Groq, free tier) ─────────────────────────────────────
# Get your free Groq API key at: https://console.groq.com
OPENAI_API_KEY=gsk_your_groq_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

# ── Kubernetes ───────────────────────────────────────────────────────────────
KUBECONFIG=~/.kube/config
ARGOCD_SERVER=localhost:8080
ARGOCD_TOKEN=your-argocd-token

# ── OpenCost ─────────────────────────────────────────────────────────────────
OPENCOST_URL=http://localhost:9090

# ── Splunk Hosted Models (AI Toolkit 5.7+ on Splunk Cloud) ───────────────────
# Set to true if you have Splunk Cloud Platform with AI Toolkit 5.7+ installed
# This enables Foundation-Sec, Cisco Deep Time Series, and GPT-OSS models
# via the | ai SPL command — data never leaves your Splunk environment
SPLUNK_CLOUD_HOSTED_MODELS=false

# ── Demo Mode (set true to run without a live cluster) ───────────────────────
DEMO_MODE=false
